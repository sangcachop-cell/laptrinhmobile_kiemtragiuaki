@model _2380601899.Core.Entities.Question
@{
    var options = Model.Options.OrderBy(o => o.OptionLabel).ToList();
    var optA = options.FirstOrDefault(o => o.OptionLabel == "A")?.OptionText ?? "";
    var optB = options.FirstOrDefault(o => o.OptionLabel == "B")?.OptionText ?? "";
    var optC = options.FirstOrDefault(o => o.OptionLabel == "C")?.OptionText ?? "";
    var optD = options.FirstOrDefault(o => o.OptionLabel == "D")?.OptionText ?? "";
    var correctOpt = options.FirstOrDefault(o => o.IsCorrect)?.OptionLabel ?? "A";
}

<div class="card border-0 shadow-sm h-100">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="badge bg-primary fs-6 px-3 py-2">Câu @Model.QuestionNumber</span>
            <button class="btn btn-sm btn-outline-secondary" type="button" 
                    onclick="openEditModal(@Model.Id, @Model.QuestionNumber, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.QuestionText ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(optA))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(optB))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(optC))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(optD))', '@correctOpt', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Hint ?? ""))')">
                <i class="bi bi-pencil-square me-1"></i>Sửa
            </button>
        </div>

        <p class="card-text fw-semibold fs-6 text-dark mt-2 mb-3">@Model.QuestionText</p>

        <div class="row g-2 mb-3">
            @foreach (var opt in options)
            {
                <div class="col-sm-6">
                    <div class="p-2 rounded border @(opt.IsCorrect ? "bg-success-subtle border-success text-success fw-bold" : "bg-white text-secondary")">
                        <span class="badge @(opt.IsCorrect ? "bg-success" : "bg-secondary") me-2">@opt.OptionLabel</span>
                        <span>@opt.OptionText</span>
                        @if (opt.IsCorrect)
                        {
                            <i class="bi bi-check-circle-fill text-success float-end"></i>
                        }
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Hint))
        {
            <div class="alert alert-info py-2 px-3 mb-0 small">
                <i class="bi bi-lightbulb-fill text-warning me-1"></i><strong>Giải thích / Gợi ý:</strong> @Model.Hint
            </div>
        }
    </div>
</div>
